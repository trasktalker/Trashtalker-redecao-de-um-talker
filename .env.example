# Modelo do .env. Copie para `.env` e preencha (o `.env` nunca vai para o
# repositório). Na Vercel, as mesmas variáveis ficam em Settings ->
# Environment Variables (o .env não é lido lá).

# Connection string do PostgreSQL (Neon ou outro). Obrigatória.
DATABASE_URL=
PORT=5000
# "production" desliga o modo debug e deixa o cookie de sessão Secure.
# (Na Vercel o cookie já é Secure de qualquer jeito.)
FLASK_ENV=development
# Origem pública do site: usada no CORS, no link do e-mail de redefinição
# de senha e na checagem de origem das rotas 2FA.
# Local: http://localhost:5000 | Vercel: https://<seu-dominio>
FRONTEND_ORIGIN=http://localhost:5000

# --- IA ------------------------------------------------------------------

# Chave do Google Gemini. Sem ela o app sobe, mas enviar mensagem devolve 502.
GEMINI_API_KEY=

# Chave do ElevenLabs (voz do botão "ouvir"). Sem ela o app sobe, mas o
# TTS devolve 502.
ELEVENLABS_API_KEY=

# --- 2FA (Google Authenticator) ------------------------------------------

# Chave Fernet persistente. Sem ela o 2FA fica indisponível (503) e contas
# com 2FA não conseguem entrar. Gere uma vez e NUNCA troque nem perca
# (os segredos do 2FA já gravados ficam ilegíveis):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# --- E-mail (opcional) ---------------------------------------------------

# Envio do e-mail de "esqueci minha senha". Sem SMTP_HOST, SMTP_USER e
# SMTP_PASSWORD, o link de redefinição é impresso no log/terminal.
# Gmail: SMTP_PASSWORD é uma "senha de app" (myaccount.google.com/apppasswords),
# que só existe com a verificação em duas etapas ativa. Se a verificação
# for desligada, o Google revoga a senha de app e o envio para de funcionar.
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS; 465 = TLS direto. As duas funcionam.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente; se vazio, usa SMTP_USER.
SMTP_FROM=
